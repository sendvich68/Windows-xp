{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Windows 34",
  "version": "2.3.0",
  "identifier": "com.windows34.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Windows 34",
        "width": 1024,
        "height": 720,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
